import random
import math
import matplotlib.pyplot as plt

# Starting point and destination
start = (0, 0)
goal = (10, 10)

# Circular obstacles (x, y, radius)
obstacles = [
    (4, 4, 1.5),
    (7, 7, 1.5)
]

# PSO parameters
num_particles = 30
max_iterations = 100
w = 0.5
c1 = 1.5
c2 = 1.5

# Number of intermediate points in the path
num_waypoints = 3


# Generate a random path
def random_path():
    path = []
    for _ in range(num_waypoints):
        path.append([
            random.uniform(0, 10),
            random.uniform(0, 10)
        ])
    return path


# Calculate distance between two points
def distance(p1, p2):
    return math.sqrt((p1[0] - p2[0])**2 +
                     (p1[1] - p2[1])**2)


# Calculate distance from obstacle to path segment
def segment_distance(a, b, center):
    dx = b[0] - a[0]
    dy = b[1] - a[1]

    if dx == 0 and dy == 0:
        return distance(a, center)

    t = ((center[0] - a[0]) * dx +
         (center[1] - a[1]) * dy) / (dx*dx + dy*dy)

    t = max(0, min(1, t))

    closest = (a[0] + t*dx, a[1] + t*dy)

    return distance(closest, center)


# Fitness function
def fitness(path):
    full_path = [start] + path + [goal]

    # Calculate total path length
    total_distance = 0

    for i in range(len(full_path) - 1):
        total_distance += distance(full_path[i], full_path[i+1])

    # Obstacle collision penalty
    penalty = 0

    for i in range(len(full_path) - 1):
        for ox, oy, radius in obstacles:
            d = segment_distance(
                full_path[i],
                full_path[i+1],
                (ox, oy)
            )

            if d < radius:
                penalty += 1000

    return total_distance + penalty


# Initialize particles
particles = [random_path() for _ in range(num_particles)]

velocities = [
    [[random.uniform(-1, 1), random.uniform(-1, 1)]
     for _ in range(num_waypoints)]
    for _ in range(num_particles)
]

pbest = [p[:] for p in particles]
pbest_scores = [fitness(p) for p in particles]

gbest_index = pbest_scores.index(min(pbest_scores))
gbest = pbest[gbest_index]
gbest_score = pbest_scores[gbest_index]


# PSO algorithm
for iteration in range(max_iterations):

    for i in range(num_particles):

        for j in range(num_waypoints):

            for k in range(2):

                r1 = random.random()
                r2 = random.random()

                # Update velocity
                velocities[i][j][k] = (
                    w * velocities[i][j][k]
                    + c1 * r1 * (pbest[i][j][k] - particles[i][j][k])
                    + c2 * r2 * (gbest[j][k] - particles[i][j][k])
                )

                # Update position
                particles[i][j][k] += velocities[i][j][k]

                # Keep points inside the boundary
                particles[i][j][k] = max(
                    0, min(10, particles[i][j][k])
                )

        # Calculate new fitness
        score = fitness(particles[i])

        # Update personal best
        if score < pbest_scores[i]:
            pbest[i] = [point[:] for point in particles[i]]
            pbest_scores[i] = score

        # Update global best
        if score < gbest_score:
            gbest = [point[:] for point in particles[i]]
            gbest_score = score


# Display best path
best_path = [start] + gbest + [goal]

print("Best path:", best_path)
print("Best path fitness:", gbest_score)


# Visualization
plt.figure(figsize=(8, 8))

# Plot path
x = [p[0] for p in best_path]
y = [p[1] for p in best_path]

plt.plot(x, y, 'bo-', label="Best Robot Path")

# Start and goal
plt.scatter(start[0], start[1], color='green', s=100, label="Start")
plt.scatter(goal[0], goal[1], color='red', s=100, label="Goal")

# Plot obstacles
for ox, oy, radius in obstacles:
    circle = plt.Circle((ox, oy), radius, color='black')
    plt.gca().add_patch(circle)

plt.xlim(0, 10)
plt.ylim(0, 10)
plt.grid(True)
plt.legend()
plt.title("Particle Swarm Optimization - Robot Path Planning")
plt.xlabel("X Coordinate")
plt.ylabel("Y Coordinate")
plt.show()
