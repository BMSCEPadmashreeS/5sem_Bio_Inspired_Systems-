import numpy as np
import matplotlib.pyplot as plt

# ----------------------------------------------------------
# 1. DEFINE THE PROBLEM
# ----------------------------------------------------------

print("PARALLEL CELLULAR AUTOMATA - IMAGE DENOISING")
print("=" * 50)

# Create a sample grayscale image
size = 128

original = np.zeros((size, size), dtype=np.uint8)

# Create square patterns
original[20:60, 20:60] = 180
original[70:110, 70:110] = 220

# Create circular pattern
y, x = np.ogrid[:size, :size]

circle = (x - 64)**2 + (y - 64)**2 <= 18**2

original[circle] = 255

print("Original image created successfully!")


# ----------------------------------------------------------
# 2. INITIALIZE PARAMETERS
# ----------------------------------------------------------

iterations = 10
threshold = 30
noise_level = 0.08

print("\nINITIAL PARAMETERS")
print("Image size:", size, "x", size)
print("Number of cells:", size * size)
print("Number of iterations:", iterations)
print("Neighborhood: 3 x 3")
print("Noise level:", noise_level)


# ----------------------------------------------------------
# 3. INITIALIZE POPULATION
# ----------------------------------------------------------

# Add salt and pepper noise
def add_noise(image, noise_level):

    noisy = image.copy()

    random_values = np.random.random(image.shape)

    noisy[random_values < noise_level / 2] = 0

    noisy[random_values > 1 - noise_level / 2] = 255

    return noisy


noisy_image = add_noise(original, noise_level)

# Each pixel represents one cell
current_state = noisy_image.copy()

print("\nInitial cellular population created!")


# ----------------------------------------------------------
# 4. EVALUATE FITNESS
# ----------------------------------------------------------

def calculate_mse(original, result):

    mse = np.mean(
        (original.astype(float) -
         result.astype(float)) ** 2
    )

    return mse


initial_mse = calculate_mse(original, noisy_image)

print("\nInitial Image MSE:", round(initial_mse, 2))


# ----------------------------------------------------------
# 5. UPDATE CELL STATES
# ----------------------------------------------------------

def parallel_cellular_automata(
    image, iterations, threshold
):

    current = image.copy()

    fitness_history = []

    for iteration in range(iterations):

        # Pad image boundaries
        padded = np.pad(
            current,
            1,
            mode='edge'
        )

        # Collect 3 x 3 neighboring pixel values
        neighbors = np.stack([
            padded[i:i + current.shape[0],
                   j:j + current.shape[1]]
            for i in range(3)
            for j in range(3)
        ])

        # Calculate median of neighboring cells
        median_values = np.median(
            neighbors,
            axis=0
        )

        # Evaluate differences
        difference = np.abs(
            current.astype(float) - median_values
        )

        # Apply cellular update rules
        updated = np.where(
            difference > threshold,
            median_values,
            current
        )

        # Update all cells simultaneously
        current = np.clip(
            updated, 0, 255
        ).astype(np.uint8)

        # Evaluate image quality
        mse = calculate_mse(original, current)

        fitness_history.append(mse)

        print(
            "Iteration:", iteration + 1,
            "| MSE:", round(mse, 2)
        )

    return current, fitness_history


# ----------------------------------------------------------
# 6. ITERATE UNTIL STOPPING CONDITION
# ----------------------------------------------------------

denoised_image, fitness_history = parallel_cellular_automata(
    noisy_image,
    iterations,
    threshold
)


# ----------------------------------------------------------
# 7. OUTPUT THE BEST SOLUTION
# ----------------------------------------------------------

def calculate_psnr(original, result):

    mse = calculate_mse(original, result)

    if mse == 0:
        return float('inf')

    return 10 * np.log10((255 ** 2) / mse)


final_mse = calculate_mse(original, denoised_image)

final_psnr = calculate_psnr(original, denoised_image)

print("\n" + "=" * 50)
print("FINAL IMAGE DENOISING RESULTS")
print("=" * 50)

print("Initial MSE:", round(initial_mse, 2))

print("Final MSE:", round(final_mse, 2))

print("Final PSNR:", round(final_psnr, 2), "dB")

print("Image denoising completed successfully!")


# ----------------------------------------------------------
# 8. DISPLAY ORIGINAL, NOISY AND DENOISED IMAGES
# ----------------------------------------------------------

plt.figure(figsize=(15, 5))

plt.subplot(1, 3, 1)

plt.imshow(original, cmap='gray', vmin=0, vmax=255)

plt.title("Original Image")

plt.axis("off")


plt.subplot(1, 3, 2)

plt.imshow(noisy_image, cmap='gray', vmin=0, vmax=255)

plt.title("Noisy Image")

plt.axis("off")


plt.subplot(1, 3, 3)

plt.imshow(denoised_image, cmap='gray', vmin=0, vmax=255)

plt.title("Denoised Image")

plt.axis("off")


plt.tight_layout()

plt.show()


# ----------------------------------------------------------
# 9. DISPLAY CONVERGENCE GRAPH
# ----------------------------------------------------------

plt.figure(figsize=(8, 4))

plt.plot(
    range(1, iterations + 1),
    fitness_history,
    marker='o',
    color='green'
)

plt.xlabel("Number of Iterations")

plt.ylabel("Mean Squared Error")

plt.title("Parallel Cellular Automata Convergence")

plt.grid(True)

plt.show()


# ----------------------------------------------------------
# 10. SAVE FINAL DENOISED IMAGE
# ----------------------------------------------------------

plt.imsave(
    "denoised_image.png",
    denoised_image,
    cmap='gray',
    vmin=0,
    vmax=255
)

print("\nDenoised image saved as denoised_image.png")

print("PROGRAM EXECUTED SUCCESSFULLY!")
