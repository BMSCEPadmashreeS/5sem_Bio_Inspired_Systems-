
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image
from scipy.ndimage import median_filter

# Parallel Cellular Automata for Image Denoising

# 1. Load input image
image = Image.open("noisy_image.png").convert("L")
original = np.array(image, dtype=np.float64)

# 2. Add salt and pepper noise
def add_noise(img, noise_level=0.08):

    noisy = img.copy()
    random_values = np.random.random(img.shape)

    noisy[random_values < noise_level / 2] = 0
    noisy[random_values > 1 - noise_level / 2] = 255

    return noisy

noisy_image = add_noise(original)

# 3. Initialize parameters
iterations = 10
threshold = 25

# 4. Initialize cellular population
current_state = noisy_image.copy()

# 5. Parallel Cellular Automata
for iteration in range(iterations):

    # Evaluate neighboring cells
    neighbor_values = median_filter(
        current_state,
        size=3,
        mode='nearest'
    )

    # Calculate difference
    difference = np.abs(
        current_state - neighbor_values
    )

    # Update all cells simultaneously
    new_state = np.where(
        difference > threshold,
        neighbor_values,
        current_state
    )

    # Update cellular states
    current_state = new_state.copy()

    print("Iteration:", iteration + 1, "Completed")

# 6. Output denoised image
denoised_image = np.clip(
    current_state, 0, 255
).astype(np.uint8)

# 7. Calculate image quality (MSE)
mse = np.mean(
    (original - denoised_image.astype(float)) ** 2
)

print("\n--- IMAGE DENOISING RESULTS ---")
print("Mean Squared Error:", round(mse, 2))

# 8. Display results
plt.figure(figsize=(12, 4))

plt.subplot(1, 3, 1)
plt.imshow(original, cmap='gray')
plt.title("Original Image")
plt.axis("off")

plt.subplot(1, 3, 2)
plt.imshow(noisy_image, cmap='gray')
plt.title("Noisy Image")
plt.axis("off")

plt.subplot(1, 3, 3)
plt.imshow(denoised_image, cmap='gray')
plt.title("Denoised Image")
plt.axis("off")

plt.tight_layout()
plt.show()

# Save final image
Image.fromarray(denoised_image).save(
    "denoised_image.png"
)

print("Denoised image saved successfully!")
