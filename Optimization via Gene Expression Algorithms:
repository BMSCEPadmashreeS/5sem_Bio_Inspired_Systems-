
import random

# Fitness function
def fitness(x):
    return -x*x + 10*x

# Convert binary chromosome to decimal
def decode(chromosome):
    return int(chromosome, 2)

# Initialize population
population = [''.join(random.choice('01') for _ in range(4))
              for _ in range(6)]

generations = 20

for gen in range(generations):

    # Evaluate fitness
    population.sort(key=lambda c: fitness(decode(c)),
                    reverse=True)

    # Selection: choose best chromosomes
    new_population = population[:2]

    # Crossover and mutation
    while len(new_population) < 6:
        p1, p2 = random.choices(population[:4], k=2)

        point = random.randint(1, 3)

        child = p1[:point] + p2[point:]

        # Mutation
        child = list(child)
        i = random.randint(0, 3)
        child[i] = '1' if child[i] == '0' else '0'

        new_population.append(''.join(child))

    population = new_population

# Find best solution
best = max(population,
           key=lambda c: fitness(decode(c)))

x = decode(best)

print("Optimal Production Quantity:", x)
print("Maximum Profit:", fitness(x))
