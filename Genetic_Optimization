import random

# 1. Define the objective function
def fitness(x):
    return x * (10 * __import__('math').pi * x).__class__(1) if False else x * __import__('math').sin(10 * __import__('math').pi * x) + 1


# 2. Initialize parameters
population_size = 20
generations = 50
crossover_rate = 0.8
mutation_rate = 0.1

# Generate initial population randomly (x between 0 and 1)
population = [random.uniform(0, 1) for _ in range(population_size)]


# Selection using tournament selection
def selection(population):
    candidates = random.sample(population, 3)
    return max(candidates, key=fitness)


# 3–8. Genetic Algorithm
for generation in range(generations):

    # Evaluate fitness
    population.sort(key=fitness, reverse=True)

    # Preserve the best solution (Elitism)
    new_population = [population[0]]

    while len(new_population) < population_size:

        # Select parents
        parent1 = selection(population)
        parent2 = selection(population)

        # Crossover
        if random.random() < crossover_rate:
            child = (parent1 + parent2) / 2
        else:
            child = parent1

        # Mutation
        if random.random() < mutation_rate:
            child += random.uniform(-0.1, 0.1)

        # Keep the solution within the range 0 to 1
        child = max(0, min(1, child))

        new_population.append(child)

    population = new_population


# 9. Display the best solution
best_solution = max(population, key=fitness)

print("Best solution:", best_solution)
print("Maximum fitness value:", fitness(best_solution))
